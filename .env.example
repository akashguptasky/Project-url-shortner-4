# === MongoDB (MANDATORY) ===
# Create a free cluster: https://www.mongodb.com/cloud/atlas -> Connect -> Drivers -> copy connection string
# Replace <password> with your DB user's password, and keep the DB name (group50Database) at the end.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/group50Database

# === Redis (OPTIONAL - for caching / Phase II) ===
# Create a free Redis: https://redis.com/try-free/  (Redis Cloud)
# Leave these three blank to run without caching (no crash).
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Server port (Codespaces sets PORT automatically; defaults to 3000 locally)
PORT=3000
